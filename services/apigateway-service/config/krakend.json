                "plugin/auth-custom": {
                    "auth": {{ marshal (index .backend 0).extra_config.auth }}
                }
            },
            "output_encoding": "no-op"
        },
        {{ end }}
        {
            "endpoint": "/health",
            "extra_config": {
                "github.com/devopsfaith/krakend/proxy": {
                    "static": {
                        "data": {
                            "status": "OK"
                        },
                        "strategy": "always"
                    }
                }
            },
            "backend": [
                {
                    "url_pattern": "/"
                }
            ]
        }
    ]
}
