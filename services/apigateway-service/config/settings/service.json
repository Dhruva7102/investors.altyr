{
    "version": 3,
    "name": "API Gateway",
    "port": 8080,
    "cache_ttl": "3600s",
    "timeout": "60000ms",
    "extra_config": {
        "plugin/auth-server": {
            "allowOrigins": [
                "*"
            ],
            "keyName": "id_rsa",
            "jwtIssuer": "http://example.com/",
            "jwtPort": 8090,
            "jwtEndpoint": "accessKeys",
            "accessTTL": "180h",
            "refreshTTL": "360h",
            "basicAuth": true
        },
        "telemetry/logging": {
            "level": "DEBUG",
            "prefix": "[API]",
            "syslog": true,
            "stdout": true
        },
        "telemetry/metrics": {
            "collection_time": "60s",
            "proxy_disabled": false,
            "router_disabled": false,
            "backend_disabled": false,
            "endpoint_disabled": false,
            "listen_address": ":8099"
        },
        "qos/ratelimit/router": {
            "maxRate": 0,
            "clientMaxRate": 0,
            "strategy": "ip"
        },
        "security/cors": {
            "allow_origins": [
                "*"
            ],
            "allow_methods": [
                "HEAD",
                "POST",
                "GET",
                "PATCH",
                "PUT",
                "DELETE"
            ],
            "allow_headers": [
                "Origin",
                "Authorization",
                "Content-Type",
                "x-csrftoken",
                "x-requested-with",
                "lan",
                "device",
                "authorization",
                "Content-Type",
                "language",
                "level",
                "latitude",
                "longitude",
                "platform",
                "ipaddress",
                "city",
                "country",
                "appName",
                "*"
            ],
            "expose_headers": [
                "Content-Length"
            ],
            "max_age": "12h"
        },
        "security/http": {
            "allowed_hosts": [],
            "sts_seconds": 300,
            "sts_include_subdomains": true,
            "frame_deny": true,
            "custom_frame_options_value": "SAMEORIGIN",
            "content_type_nosniff": true,
            "browser_xss_filter": true,
            "content_security_policy": "default-src 'none'; script-src 'self'; connect-src 'self'; img-src 'self'; style-src 'self';frame-ancestors 'none'; upgrade-insecure-requests;"
        }
    }
}