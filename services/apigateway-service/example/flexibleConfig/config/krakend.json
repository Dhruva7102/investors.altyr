{
    "version": 2,
    "name": "{{ .service.name }}",
    "port": {{ .service.port }},
    "cache_ttl": "{{ .service.cache_ttl }}",
    "timeout": "{{ .service.timeout }}",
    "extra_config": {{ marshal .service.extra_config }},
    "endpoints": [
        {{ range .nodeApi.endpoints }}
        {
            "endpoint": "{{ .endpoint }}",
            "method": "{{ .method }}",
            "querystring_params": {{ marshal .querystring_params }},
            "headers_to_pass": {{ marshal .headers_to_pass }},
            "backend": [
                {{ range .backend }}
                    {
                        "url_pattern": "{{ .url_pattern }}",
                        "encoding": "no-op",
                        "host": {{ marshal .host }},
                        "extra_config": {
                            "auth": {{ marshal .extra_config.auth }},
                            {{ include "rate_limit.tmpl" }}
                        }
                    }
                {{ end }}
            ],
            "output_encoding": "no-op"
        },
        {{ end }}
